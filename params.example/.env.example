# =============================================================================
# InfraWeaver — .env.example
#
# Copy to .env (gitignored) and fill in YOUR values, or run: scripts/setup.sh
# Then run: scripts/generate-from-env.sh  (substitutes ${VARS} into kubernetes/,
# envs/ and users.yaml before ArgoCD bootstrap).
#
# IMPORTANT: values are parsed as the ENTIRE text after '='. Do NOT put inline
# comments on a KEY=value line — keep comments on their own lines (like this).
# Secrets are intentionally BLANK — never commit real secret values.
# =============================================================================

# ── Identity (the values most forkers must change) ───────────────────────────
# Base domain; apps are served at *.${BASE_DOMAIN} and *.int.${BASE_DOMAIN}
BASE_DOMAIN=example.com
# Platform admin + Let's Encrypt account email
ADMIN_EMAIL=admin@example.com
# Personal admin login (Authentik username)
ADMIN_USERNAME=admin
# Display name for the admin user
ADMIN_NAME=Platform Admin
# Cluster name (must match envs/<env>/cluster.yaml)
K8S_CLUSTER_NAME=infraweaver
CLUSTER_LOCAL_DOMAIN=cluster.local

# ── Git & image identity ─────────────────────────────────────────────────────
# INFRA_REPO_URL = the generic IaC TEMPLATE repo you forked (this repo). It holds
# ${PLACEHOLDER} manifests and is safe to keep public.
INFRA_REPO_URL=https://github.com/your-org/your-infra-repo
# DEPLOY_REPO_URL = the repo ArgoCD actually watches, holding the RENDERED
# (concrete) manifests produced by scripts/generate-from-env.sh. Point this at a
# PRIVATE repo when your rendered values (domain, emails, internal IPs) must not
# be public. Leave BLANK to use a single repo: it defaults to INFRA_REPO_URL.
DEPLOY_REPO_URL=
# GIT_REPO_URL / GITHUB_REPO = the application/code repo (console + API source)
GIT_REPO_URL=https://github.com/your-org/your-platform-repo
GITHUB_REPO=your-org/your-platform-repo
GITHUB_ORG=your-org
# Container image registry hosting your built console/api/node images
IMAGE_REGISTRY=ghcr.io/your-org
# PAT with repo + write:packages (SECRET)
GITHUB_PAT=
# GitHub Actions runner registration token (SECRET)
RUNNER_REGISTRATION_TOKEN=

# ── Proxmox / nodes ──────────────────────────────────────────────────────────
PROXMOX_HOST=10.0.0.3
# terraform@pve!token=<uuid> (SECRET)
PROXMOX_API_TOKEN=
PROXMOX_NODE_NAME=pve
TALOS_DATASTORE=local-lvm
NODE_GATEWAY=10.0.0.1
NODE_SUBNET_PREFIX=24
# comma-separated name:ip pairs
PVE_NODES=pve:10.0.0.3
# CIDR of the Kubernetes node VLAN (used in NetworkPolicies / allow-lists)
NODE_SUBNET_CIDR=10.0.0.0/24
# CIDR of the Proxmox / management network
MGMT_SUBNET_CIDR=10.0.1.0/24
# Gateway on the Proxmox / management network
MGMT_GATEWAY=10.0.1.1
# Host running the GitHub Actions runner + feedback dispatch service
RUNNER_IP=10.0.0.50

# ── MetalLB (L2) ─────────────────────────────────────────────────────────────
METALLB_VIP_RANGE=10.0.0.200-10.0.0.210
METALLB_TRAEFIK_VIP=10.0.0.200
METALLB_COREDNS_VIP=10.0.0.201
# Address range of the general (vlan3) LoadBalancer pool, excluding the
# dedicated Traefik/CoreDNS VIPs above.
METALLB_VLAN3_POOL_RANGE=10.0.0.202-10.0.0.210
# Dedicated VIP for n8n LoadBalancer (if ENABLE_N8N_AUTOMATION=true)
METALLB_VIP_206=10.0.0.206
# Trusted internal CIDRs allowed to reach *.int routes
LOCAL_IP_RANGES=10.0.0.0/24,192.168.0.0/16

# ── External storage / infra hosts (optional; only if your console uses them) ─
# Synology / TrueNAS NAS endpoints for share management + Longhorn backups
SYNOLOGY_HOST=10.0.1.21
TRUENAS_HOST=10.0.1.135
# Active Directory / domain controller (if AUTHENTIK LDAP federates to it)
DC1_IP=10.0.1.43
# External OpenBao/Vault host (if not using the in-cluster instance)
OPENBAO_EXTERNAL_HOST=10.0.1.241

# ── Talos node topology (mirrors envs/<env>/cluster.yaml) ─────────────────────
NODE_COUNT=3
NODE_1_IP=10.0.0.11
NODE_1_VMID=9300
NODE_1_PVE_NODE=pve
NODE_1_DATASTORE=local-lvm
NODE_1_CPU=8
NODE_1_MEMORY=16384
NODE_1_DISK=200
NODE_1_ROLE=controlplane
NODE_2_IP=10.0.0.12
NODE_2_VMID=9301
NODE_2_PVE_NODE=pve
NODE_2_DATASTORE=local-lvm
NODE_2_CPU=8
NODE_2_MEMORY=16384
NODE_2_DISK=200
NODE_2_ROLE=controlplane
NODE_3_IP=10.0.0.13
NODE_3_VMID=9302
NODE_3_PVE_NODE=pve
NODE_3_DATASTORE=local-lvm
NODE_3_CPU=6
NODE_3_MEMORY=8192
NODE_3_DISK=130
NODE_3_ROLE=controlplane

# ── Deployer SSH key (private key; SECRET) ───────────────────────────────────
# Paste a full OpenSSH private key block. The public half is derived automatically.
DEPLOYER_SSH_KEY=

# ── DNS / ACME provider (cert-manager DNS-01) ────────────────────────────────
# cloudflare | route53 | azure | digitalocean | hetzner | none
DNS_PROVIDER=cloudflare
# staging | production
LETSENCRYPT_ENV=staging
# (SECRET) if DNS_PROVIDER=cloudflare
CLOUDFLARE_API_TOKEN=
# Cloudflare Zone ID for BASE_DOMAIN (not secret, but deployment-specific) —
# used by the optional n8n DNS-manager/health blueprints.
CLOUDFLARE_ZONE_ID=
# (SECRET) if route53
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_HOSTED_ZONE_ID=
AWS_REGION=us-east-1
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
DIGITALOCEAN_TOKEN=
HETZNER_DNS_API_KEY=

# ── SMTP (notifications / recovery emails) ───────────────────────────────────
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TO=admin@example.com

# ── Feature toggles ──────────────────────────────────────────────────────────
ENV_NAME=productie
ENABLE_MONITORING=true
ENABLE_EXTERNAL_DNS=false
ENABLE_LONGHORN=true
ENABLE_KYVERNO=true
ENABLE_LOKI=false
BACKUP_PROVIDER=none

# ── Optional ─────────────────────────────────────────────────────────────────
# INTERNAL_DOMAIN=int.example.com     (override; defaults to int.${BASE_DOMAIN})
# ENABLE_N8N_AUTOMATION=false         (legacy n8n bug/feature/DNS workflows)
# WEBHOOK_DOMAIN=example.com          (legacy n8n webhook domain; defaults to BASE_DOMAIN)

# =============================================================================
# NOTE: the user-feedback submission URL is the ONE value that is NOT
# configurable. Every deployment reports feedback to the canonical InfraWeaver
# endpoint by design (hardcoded in the console). See README "The one fixed value".
# =============================================================================

# Public IPv4 of your ingress (Cloudflare *.int A-record / external-dns target)
PUBLIC_INGRESS_IP=203.0.113.10
